<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared Info.plist keys for the iOS app. HealthKit usage text must be
     specific because Apple rejects generic descriptions. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- App is fully local and uses no custom encryption (only system HTTPS/
         none at all), so it is export-compliance exempt. This skips the
         compliance question on every App Store Connect upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSHealthShareUsageDescription</key>
    <string>האפליקציה קוראת שונות קצב הלב (HRV) כדי לבנות עבורך טווח אישי ולזהות שינוי מתמשך במנוחה. נתוני אימונים, שינה ודופק במנוחה נקראים כדי להתעלם ממדידות שאינן במנוחה ולהציג לצד אירוע מה עוד היה נכון באותו הזמן. הנתונים נשארים על המכשיר בלבד.</string>
    <!-- Apple requires this key whenever the HealthKit entitlement is present,
         even for read-only apps. HRV-C never writes to Apple Health, so this
         prompt is never actually shown. -->
    <key>NSHealthUpdateUsageDescription</key>
    <string>האפליקציה אינה כותבת נתונים ל-Apple Health — היא קוראת בלבד.</string>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
